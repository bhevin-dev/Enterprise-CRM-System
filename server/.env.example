# Server port
PORT=5000

# MongoDB Atlas connection string
# Replace <user>, <password>, <cluster>, <db> with your Atlas credentials
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# JWT secrets and lifetimes
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Client origin for CORS
CLIENT_URL=http://localhost:5173

# Seed admin credentials (used by `npm run seed`)
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@crm.com
SEED_ADMIN_PASSWORD=Admin@123
